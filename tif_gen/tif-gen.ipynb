    "#Alternative loading rasters via masked\n",
    "#aoi = shape(feature['geometry'])\n",
    "#with fiona.open(\"tests/data/box.shp\", \"r\") as shapefile:\n",
    "#    shapes = [feature[\"geometry\"] for feature in shapefile]\n",
    "\n",
    "#transform bounds from WGS84 to Given UTM Zone...\n",
    "# https://rasterio.readthedocs.io/en/latest/api/rasterio.warp.html#rasterio.warp.transform_bounds\n",
    "#with rasterio.open(naip_merge) as src:\n",
